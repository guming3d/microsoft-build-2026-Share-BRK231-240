# Copy to ".env" and fill in, then load with:  python -m dotenv ...  or export manually.
# --- Option A: API key (quickest) -----------------------------------------
WEBIQ_API_KEY=

# --- Option B: Entra ID (production; client-credentials) ------------------
# Leave WEBIQ_API_KEY blank and set all three of these to use Entra instead.
WEBIQ_TENANT_ID=
WEBIQ_CLIENT_ID=
WEBIQ_CLIENT_SECRET=

# --- Optional ------------------------------------------------------------
# Override the API base URL (defaults to https://api.microsoft.ai/v3)
WEBIQ_BASE_URL=
